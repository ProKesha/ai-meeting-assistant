DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_meeting_assistant
TRANSCRIPTION_PROVIDER=local
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
LOCAL_EMBEDDING_DEVICE=cpu
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_ANALYSIS_MODEL=llama3.2:3b

# Docker Compose development configuration
POSTGRES_DB=ai_meeting_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-for-local-development
BACKEND_PORT=8000
DOCKER_PUBLIC_API_BASE_URL=http://localhost:8000
# The recommended local-ai profile runs Ollama inside Docker Compose.
DOCKER_OLLAMA_BASE_URL=http://ollama:11434
